BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime/
BOSON_API_KEY=
BOSON_REALTIME_MODEL=higgs-realtime
BOSON_REALTIME_VOICE=default
BOSON_REALTIME_INSTRUCTIONS=
BOSON_PIPECAT_LOG_LEVEL=INFO

# User transcripts are enabled by default in the example with this ASR model.
# Set BOSON_ASR_MODEL=none to suppress client-facing user transcript events.
BOSON_ASR_MODEL=higgs-stt-3.1
BOSON_ASR_LANGUAGE=

# Optional: near_field or far_field.
BOSON_NOISE_REDUCTION=

# Optional: audio or text.
BOSON_OUTPUT_MODALITIES=audio

# Boson Avatar example (examples/pipecat_boson_avatar_daily.py).
# The Avatar session API URL is supplied by the application; there is no default.
BOSON_AVATAR_API_URL=
# Defaults to BOSON_API_KEY when empty.
BOSON_AVATAR_API_KEY=
BOSON_AVATAR_ID=
# A Daily REST API key creates rooms and one meeting token per participant.
DAILY_API_KEY=
# Optional existing room. It is never deleted by the example.
DAILY_ROOM_URL=
